# ─── Server ──────────────────────────────────────────────────
PORT=10000
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# ─── Auth ─────────────────────────────────────────────────────
# MUST be a long random string (32+ chars). Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRE=7d

# ─── Frontend URL (set to your Vercel URL after deploy) ────────
CLIENT_URL=https://your-frontend.vercel.app
# CLIENT_URL_2=https://your-other-domain.com   # optional second origin

# ─── Cloudinary (for image uploads) ───────────────────────────
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# ─── Brevo (for email/SMS) ─────────────────────────────────────
BREVO_ENV=your_brevo_api_key_here

# ─── Legacy email (not used if Brevo is active) ───────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=replace_with_your_email@gmail.com
EMAIL_PASS=replace_with_app_password
EMAIL_FROM=Snigdha Beauty Parlour <noreply@snigdhabeautyparlour.com>
ADMIN_EMAIL=admin@snigdhabeautyparlour.com
